{
  "name": "@persian-braille/web",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.21.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"const f=require('node:fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('.tsbuildinfo',{force:true})\"",
    "test": "pnpm --filter @persian-braille/core run build && pnpm --filter @persian-braille/sdk run build && pnpm run build && node --test test/web-playground.test.mjs",
    "preview": "node preview.mjs"
  },
  "dependencies": {
    "@persian-braille/sdk": "workspace:*"
  },
  "description": "Browser-local Persian Braille playground powered by @persian-braille/sdk."
}
