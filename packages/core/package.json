{
  "name": "@persian-braille/core",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.21.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run spec:prepare && tsc -p tsconfig.json",
    "typecheck": "pnpm run spec:prepare && tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"const f=require('node:fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('src/generated',{recursive:true,force:true})\"",
    "spec:prepare": "node ../../tools/architecture/build-runtime-spec-bundle.mjs",
    "test": "pnpm run build && node --test test/unicode-preprocessor.test.mjs test/rule-selector.test.mjs test/forward-translator.test.mjs test/canonical-execution-bridge.test.mjs"
  }
}
