{
  "name": "@persian-braille/sdk",
  "version": "2.0.0-dev",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.21.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"const f=require('node:fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('.tsbuildinfo',{force:true})\"",
    "test": "pnpm --filter @persian-braille/core run build && pnpm run build && node --test test/public-api.test.mjs"
  },
  "dependencies": {
    "@persian-braille/core": "workspace:*"
  },
  "description": "Public TypeScript SDK for Persian Braille translation backed by @persian-braille/core.",
  "license": "MIT",
  "author": "Soroush Neyestani",
  "homepage": "https://github.com/soroushneyestani/Persian-to-Braille#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroushneyestani/Persian-to-Braille.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/soroushneyestani/Persian-to-Braille/issues"
  },
  "keywords": [
    "persian",
    "braille",
    "accessibility",
    "sdk",
    "typescript",
    "unicode",
    "iran"
  ],
  "publishConfig": {
    "access": "public"
  }
}
