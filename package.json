{
  "name": "persian-to-braille",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.21.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm run build && pnpm -r --if-present run typecheck",
    "clean": "pnpm -r --if-present run clean",
    "spec:bundle": "node tools/architecture/build-runtime-spec-bundle.mjs",
    "validate:boundaries": "node tools/architecture/validate-package-boundaries.mjs",
    "validate:hygiene": "node tools/architecture/validate-repository-hygiene.mjs",
    "validate:spec-determinism": "node tools/architecture/validate-runtime-spec-determinism.mjs",
    "validate:runtime": "node tools/architecture/validate-runtime-spec-consumption.mjs",
    "validate:architecture": "pnpm run validate:boundaries && pnpm run validate:hygiene && pnpm run validate:spec-determinism && pnpm run validate:phase8-consumer-contract",
    "validate:normalization": "node tools/normalization/validate-phase4-normalization.mjs",
    "conformance:write-report": "pnpm --filter @persian-braille/core run build && node tools/conformance/profile-conformance-report.mjs --write",
    "test:conformance": "pnpm --filter @persian-braille/core run build && node --test tools/conformance/profile-scenario-harness.test.mjs tools/conformance/profile-scenario-suite.test.mjs tools/conformance/profile-conformance-report.test.mjs",
    "validate:conformance": "pnpm run test:conformance && node tools/conformance/profile-conformance-report.mjs --check",
    "validate:sdk-package": "pnpm --filter @persian-braille/core run build && pnpm --filter @persian-braille/sdk run build && node tools/sdk/validate-sdk-package.mjs",
    "validate:phase8-consumer-contract": "node tools/architecture/validate-phase8-consumer-contract.mjs",
    "validate:phase8-consumers": "pnpm run build && node --test tools/consumers/phase8-consumer-integration.test.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "description": "Specification-driven Persian Braille translation workspace.",
  "license": "MIT",
  "author": "Soroush Neyestani",
  "homepage": "https://github.com/soroushneyestani/Persian-to-Braille#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroushneyestani/Persian-to-Braille.git"
  },
  "bugs": {
    "url": "https://github.com/soroushneyestani/Persian-to-Braille/issues"
  }
}
