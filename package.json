{
  "name": "persian-to-braille",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.21.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "clean": "pnpm -r --if-present run clean",
    "spec:bundle": "node tools/architecture/build-runtime-spec-bundle.mjs",
    "validate:boundaries": "node tools/architecture/validate-package-boundaries.mjs",
    "validate:hygiene": "node tools/architecture/validate-repository-hygiene.mjs",
    "validate:spec-determinism": "node tools/architecture/validate-runtime-spec-determinism.mjs",
    "validate:runtime": "node tools/architecture/validate-runtime-spec-consumption.mjs",
    "validate:architecture": "pnpm run validate:boundaries && pnpm run validate:hygiene && pnpm run validate:spec-determinism",
    "validate:normalization": "node tools/normalization/validate-phase4-normalization.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
