  "rules": [
    {
      "id": "DE-CASE-001",
      "section": "2.6",
      "kind": "DEFAULT_CASE_POLICY",
      "summary": "German Braille normally does not distinguish uppercase and lowercase in ordinary running text.",
      "mode": "SELECTIVE_CASE_MARKING",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-CASE-002",
      "section": "2.6",
      "kind": "MANDATORY_CASE_CONTEXTS",
      "summary": "Case must be represented for abbreviations and units without abbreviation points, Roman numerals, and profile-dependent structuring letters.",
