      },
      "summary": "A capital letter followed by one or more lowercase letters uses the dots-4-6 marker.",
      "followingLowercaseRequiresMarker": false,
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-CASE-005",
      "section": "2.6.1",
