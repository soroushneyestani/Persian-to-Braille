      "section": "2.6",
      "kind": "SYSTEMATIC_CAPITAL_MODE",
      "summary": "A document may explicitly mark all uppercase letters; in that mode unannounced letters are lowercase.",
      "mode": "SYSTEMATIC_CAPITAL_MARKING",
      "normative": true,
      "executable": false
    },
    {
