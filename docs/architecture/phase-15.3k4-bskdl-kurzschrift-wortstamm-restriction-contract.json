  "formalRules": [
    {
      "id": "DE-KURZ-REST-494-001",
      "sourceSection": "4.9.4",
      "kind": "WORD_OR_WORD_STEM_IDENTITY_REQUIRED",
      "summary": "Unlike Lautgruppenkürzungen, word and word-stem contractions from §§4.3-4.6 may only be used when the relevant letter sequence actually constitutes a word or word stem.",
      "normative": true,
      "scope": [
        "SECTION_4_3",
        "SECTION_4_4",
        "SECTION_4_5",
        "SECTION_4_6"
      ],
      "explicitContrast": "LAUTGRUPPENKUERZUNGEN",
      "dependencies": [
        "WORD_STEM_IDENTITY_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-REST-494-002",
      "sourceSection": "4.9.4",
      "kind": "STEM_MEANING_VARIATION_ALLOWED",
      "summary": "The represented stem may occur with different meanings, but the contraction must recognizably represent the actual word stem.",
      "normative": true,
      "dependencies": [
        "WORD_STEM_IDENTITY_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-REST-494-003",
      "sourceSection": "4.9.4",
      "kind": "STEM_RELATIVE_INITIAL_POSITION_REQUIRED",
      "summary": "For most contractions from §§4.3-4.6, the contracted letter sequence must stand at the beginning of the relevant word/stem component, disregarding prefixes and word compounds as the source specifies.",
      "normative": true,
      "precision": "This must not be implemented as a naive absolute string-position-zero test; source-positive examples include forms following prefixes or within recognized compounds.",
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER",
        "WORD_STEM_IDENTITY_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-REST-494-004",
      "sourceSection": "4.9.4",
      "kind": "HISTORICALLY_ESTABLISHED_DEVIATIONS_POLICY",
      "summary": "Historically established spellings that deviate from the general stem-oriented rule are not to be categorically abandoned.",
      "normative": true,
      "executableGeneralization": false,
      "reason": "The source establishes a historical exception policy but does not define an exhaustive generic exception set.",
      "dependencies": [
        "HISTORICAL_KURZSCHRIFT_EXCEPTION_REGISTRY"
      ]
    },
    {
      "id": "DE-KURZ-REST-494-005",
      "sourceSection": "4.9.4",
      "kind": "KOMM_ALWAYS_ALLOWED_EXCEPTION",
