      "excludedHosts": [
        "Excel",
        "PowerPoint",
        "Word on the web",
        "Word on Mac"
      ],
      "output": "Unicode Braille Music inserted at the current Word selection/cursor"
    },
    "pipeline": [
      "Task-pane local MIDI file selection",
      "Read file bytes as ArrayBuffer",
      "Standard MIDI File parser",
      "Neutral semantic music model",
      "Music Braille rule engine",
      "Canonical Unicode Braille rendering",
      "Preview",
      "Word selection insertion adapter"
    ],
    "hardBoundary": "Do not encode MIDI events directly to Braille cells. The MIDI parser must terminate at a neutral semantic music model so future input adapters can reuse the Music Braille engine without changing the public rule layer.",
    "ui": {
      "section": "Braille Music inside the existing Word task pane",
      "actions": [
        "Choose MIDI File",
        "Generate Braille",
        "Insert into Word"
      ],
      "mode": [
        "Full notation",
        "Custom"
      ],
      "candidateOptions": [
        "notes",
        "durations",
        "octaves",
        "accidentals",
        "rests",
        "chords",
        "voices/tracks",
        "key signature",
        "time signature",
        "tempo"
      ],
      "sourceCapabilityRule": "Only expose or enable notation features that the MIDI semantic model can support without inventing information."
    },
    "standardsPolicy": {
      "primaryMusicCode": "Music Braille Code 2015",
      "internationalCompanion": "New International Manual of Braille Music Notation (1996)",
      "inputFormat": "Standard MIDI Files (SMF)",
      "officeInsertion": "Word.Range.insertText / WordApi 1.1"
    },
    "phase14NonGoals": [
      "No MusicXML adapter",
      "No Excel or PowerPoint music UI",
      "No Office Web or Mac music support",
      "No audio-to-score transcription",
      "No OCR/PDF score recognition",
      "No heuristic invention of notation absent from MIDI",
      "No Marketplace publication work"
    ]
  },
