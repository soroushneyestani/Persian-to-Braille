    "principle": "ADMISSION_IS_NOT_EXECUTION; canonical rules remain immutable and no rule is executable merely because it is admitted to B4 lowering.",
    "taxonomy": {
      "LOWERING_CANDIDATE": {
        "directLoweringEligible": true,
        "meaning": "Frozen semantics participate directly in Basisschrift lowering during B4."
      },
      "DELEGATED_DEPENDENCY": {
        "directLoweringEligible": false,
        "meaning": "The rule delegates ownership to another runtime component or semantic owner and must not be independently lowered."
      },
      "DEFERRED_DEPENDENCY": {
        "directLoweringEligible": false,
        "meaning": "The source classification intentionally deferred execution until a dependency was materialized; B4 must resolve that dependency before execution admission."
      },
      "CROSS_MODE_DEFERRED": {
        "directLoweringEligible": false,
        "meaning": "The rule is excluded from Basisschrift execution and belongs to a later German text mode."
      },
      "REFERENCE_ONLY": {
        "directLoweringEligible": false,
        "meaning": "Normative/reference data participates in evidence but is not an independent Basisschrift execution rule."
      },
      "ARCHITECTURAL_ONLY": {
        "directLoweringEligible": false,
        "meaning": "Architecture-only material must never be emitted as runtime behavior."
      }
    },
