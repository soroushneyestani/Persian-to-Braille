  "ruleFamilies": [
    {
      "id": "DE-VOLL-FAMILY-001",
      "name": "BASISSCHRIFT_INHERITANCE",
      "source": "Chapter 3 opening",
      "summary": "Vollschrift inherits all signs and rules of Basisschrift.",
      "architecturalRole": "PROFILE_EXTENSION",
      "normative": true
    },
    {
      "id": "DE-VOLL-FAMILY-002",
      "name": "LAUTGRUPPENKUERZUNGEN",
      "source": "Chapter 3 opening table",
      "summary": "Eight additional sound-group contractions are introduced.",
      "recordCount": 8,
      "normative": true
    },
    {
      "id": "DE-VOLL-FAMILY-003",
      "name": "COMPOUND_WORD_SEAM_RESTRICTION",
      "source": "Chapter 3",
      "summary": "Contractions must not cross compound-word seams (Wortfugen).",
      "appliesTo": [
        "vollschrift",
        "kurzschrift"
      ],
      "normative": true
    },
    {
      "id": "DE-VOLL-FAMILY-004",
      "name": "DERIVATIONAL_SEAM_RESTRICTION",
      "source": "Chapter 3",
      "summary": "Clearly recognizable prefixes and suffixes must not be joined to the word stem through a contraction.",
      "appliesTo": [
        "vollschrift",
        "kurzschrift"
      ],
      "normative": true
    },
    {
      "id": "DE-VOLL-FAMILY-005",
      "name": "SPOKEN_SYLLABLE_BOUNDARY",
      "source": "Chapter 3",
      "summary": "Except for the st contraction, Vollschrift contractions must not cross spoken-syllable boundaries.",
      "exception": "ST",
      "normative": true
    },
    {
      "id": "DE-VOLL-FAMILY-006",
      "name": "PRONUNCIATION_SENSITIVE_ELIGIBILITY",
      "source": "Chapter 3",
      "summary": "Vowel-group contractions and sch depend on actual pronunciation rather than on orthographic substring matching alone.",
      "vowelGroups": [
        "au",
        "eu",
        "ei",
        "äu",
        "ie"
      ],
      "schRequiresSingleSound": true,
      "normative": true
    },
    {
      "id": "DE-VOLL-FAMILY-007",
      "name": "ST_EXCEPTION_POLICY",
      "source": "Chapter 3",
      "summary": "The st contraction has specific exclusions derived from pronunciation and established Kurzschrift/application tradition.",
      "excludedContexts": [
        "STH_WHEN_TH_IS_ONE_SOUND",
        "SST_DOUBLE_S_PRIORITY",
        "ABBREVIATION_ST_FOR_SANKT"
      ],
      "normative": true
    },
    {
      "id": "DE-VOLL-FAMILY-008",
      "name": "STANDALONE_WORD_ELIGIBILITY",
      "source": "Chapter 3",
      "summary": "Vollschrift Lautgruppenkürzungen may also represent independent words when the letter group itself forms that word.",
      "sourceExamples": [
        "Au",
        "Ei"
      ],
      "normative": true
    }
  ],
