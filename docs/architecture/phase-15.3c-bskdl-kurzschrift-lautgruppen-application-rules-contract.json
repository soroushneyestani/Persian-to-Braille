  "formalRules": [
    {
      "id": "DE-KURZ-LG-001",
      "sourceSection": "4.1.2.1",
      "kind": "LITERAL_LETTER_DISAMBIGUATION",
      "summary": "Literal c, q, x, y and ß require the Aufhebungspunkt because their cells are also used by Lautgruppenkürzungen.",
      "normative": true,
      "sourceWitnesses": [
        "c (ch, ck und sch nicht mitgezählt), q, x und y sowie ß",
        "Aufhebungspunkt 6"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-002",
      "sourceSection": "4.1.2.2",
      "kind": "PUNCTUATION_COLLISION_GUARD",
      "summary": "A Lautgruppenkürzung must not be used where its cell would be ambiguous with a punctuation sign.",
      "normative": true,
      "sourceWitnesses": [
        "sind zugleich Satzzeichen",
        "nicht angewendet, wenn Verwechslung"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-003",
      "sourceSection": "4.1.2.2",
      "kind": "TE_WORD_INITIAL_PROHIBITION",
      "summary": "The TE contraction is forbidden at word start.",
      "normative": true,
      "sourceWitnesses": [
        "\"te\" am Wortanfang"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-004",
      "sourceSection": "4.1.2.2",
      "kind": "WORD_FINAL_PUNCTUATION_PROHIBITION",
      "summary": "AL, AN, AR, BE and OR are forbidden at word end.",
      "normative": true,
      "sourceWitnesses": [
        "\"al\", \"an\", \"ar\", \"be\" und \"or\" am Wortende"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-005",
      "sourceSection": "4.1.2.2",
      "kind": "EH_EDGE_PROHIBITION",
      "summary": "EH is forbidden at word start and word end.",
      "normative": true,
      "sourceWitnesses": [
        "\"eh\" am Wortanfang und -ende"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-006",
      "sourceSection": "4.1.2.3",
      "kind": "WORD_INITIAL_SEMANTIC_COLLISION_SET",
      "summary": "The source defines an explicit set of Lautgruppen that may not contract at word start because the same signs have other meanings there.",
      "normative": true,
      "sourceWitnesses": [
        "Folgende Lautgruppen werden am Wortanfang nicht gekürzt",
        "\"ach\"",
        "\"ck\"",
        "\"ich\"",
        "\"ig\"",
        "\"lich\"",
        "\"ll\"",
        "\"mm\"",
        "\"te\""
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-007",
      "sourceSection": "4.1.2.3",
      "kind": "TWO_FORM_WORD_INITIAL_PROHIBITION",
      "summary": "Two-form Lautgruppenkürzungen are also forbidden at word start.",
      "normative": true,
      "sourceWitnesses": [
        "Ebenfalls am Wortanfang nicht zulässig sind die zweiformigen Lautgruppenkürzungen"
      ],
      "dependencies": [
        "SECTION_4_4_TWO_FORM_CONTRACTION_INVENTORY"
      ]
    },
    {
      "id": "DE-KURZ-LG-008",
      "sourceSection": "4.1.2.4",
      "kind": "COMPOUND_SEAM_PROHIBITION",
      "summary": "Lautgruppenkürzungen may not cross a clearly recognized compound-word seam.",
      "normative": true,
      "sourceWitnesses": [
        "Unzulässig sind Lautgruppenkürzungen über die eindeutige Wortfuge zusammengesetzter Wörter hinweg"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-LG-009",
      "sourceSection": "4.1.2.4",
      "kind": "LEXICALIZED_COMPOUND_EXCEPTION",
      "summary": "If a historical compound is no longer generally perceived or recognized as a compound, a Lautgruppenkürzung may cross that historical seam.",
      "normative": true,
      "sourceWitnesses": [
        "nicht mehr von allen Menschen als solches empfunden oder erkannt"
      ],
      "dependencies": [
        "LEXICALIZATION_OR_COMPOUND_RECOGNITION_POLICY"
      ]
    },
    {
      "id": "DE-KURZ-LG-010",
      "sourceSection": "4.1.2.4",
      "kind": "CROSS_SPOKEN_SYLLABLE_ELIGIBILITY",
      "summary": "Kurzschrift Lautgruppen may span adjacent spoken syllables inside a word provided the rules of 4.1.2.4 through 4.1.2.8 remain satisfied.",
      "normative": true,
      "sourceWitnesses": [
        "benachbarten Sprechsilben angehören",
        "4.1.2.4-4.1.2.8"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-011",
      "sourceSection": "4.1.2.4",
      "kind": "CLEAR_PREFIX_SUFFIX_PRESERVATION",
      "summary": "Clearly recognizable prefixes and suffixes must remain structurally preserved.",
      "normative": true,
      "sourceWitnesses": [
        "Eindeutig erkennbare Prä- und Suffixe",
        "sollen erhalten bleiben"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-LG-012",
      "sourceSection": "4.1.2.4",
      "kind": "PREFIX_BOUNDARY_UNCERTAINTY",
      "summary": "The source does not define a complete fixed rule set for all prefixes because prefix-to-stem boundaries are not always unambiguous.",
      "normative": true,
      "sourceWitnesses": [
        "Für Präfixe können keine festen Regeln formuliert werden",
        "nicht immer eindeutig"
      ],
      "dependencies": [
        "PREFIX_SUFFIX_BOUNDARY_RESOLUTION_POLICY"
      ]
    },
    {
      "id": "DE-KURZ-LG-013",
      "sourceSection": "4.1.2.4",
      "kind": "DOUBLE_CONSONANT_BOUNDARY_EXCEPTION",
      "summary": "LL, MM (including KOMM) and SS may be used across a prefix-to-stem transition and in doubtful cases.",
      "normative": true,
      "sourceWitnesses": [
        "Die Kürzungen für \"ll\", \"mm\" (auch \"komm\") und \"ss\" dürfen",
        "beim Übergang vom Präfix zum Wortstamm"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-014",
      "sourceSection": "4.1.2.4",
      "kind": "SOURCE_LISTED_OPTIONAL_VARIANTS",
      "summary": "For the source-listed doubt cases the standard distinguishes a recommended rendering and an also-permitted rendering. This does not create a global optionality rule.",
      "normative": true,
      "sourceWitnesses": [
        "Empfohlen Auch erlaubt"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-015",
      "sourceSection": "4.1.2.4",
      "kind": "MANDATORY_SUFFIX_PRESERVATION_SET",
      "summary": "The suffixes MENT, TUM, CHEN and LEIN must remain preserved.",
      "normative": true,
      "sourceWitnesses": [
        "Die Suffixe (\"Nachsilben\" von Wortstämmen) \"ment\", \"tum\", \"chen\" und \"lein\" müssen erhalten bleiben"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-016",
      "sourceSection": "4.1.2.4",
      "kind": "AMBIGUOUS_SUFFIX_BOUNDARY_EXCEPTION",
      "summary": "If the relevant stem/suffix boundary is not recognizable, the contraction may remain applicable; Engelein is the direct source witness.",
      "normative": true,
      "sourceWitnesses": [
        "\"Engelein\" jedoch gekürzt",
        "nicht erkennbar"
      ],
      "dependencies": [
        "PREFIX_SUFFIX_BOUNDARY_RESOLUTION_POLICY"
      ]
    },
    {
      "id": "DE-KURZ-LG-017",
      "sourceSection": "4.1.2.5",
      "kind": "SAME_SYLLABLE_VOWEL_PAIR_PROTECTION",
      "summary": "Two vowels belonging to the same syllable must not be separated by contractions with neighboring consonants.",
      "normative": true,
      "sourceWitnesses": [
        "Zwei Vokale, die zu ein und derselben Silbe gehören, dürfen nicht"
      ],
      "dependencies": [
        "PRONUNCIATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-LG-018",
      "sourceSection": "4.1.2.5",
      "kind": "VOWEL_PAIR_SCOPE",
      "summary": "The same-syllable protection applies both to double vowels and to two different vowels.",
      "normative": true,
      "sourceWitnesses": [
        "Dies gilt sowohl für zwei gleiche Vokale (Doppelvokal) als auch für zwei unterschiedliche"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-019",
      "sourceSection": "4.1.2.5",
      "kind": "CROSS_SYLLABLE_VOWEL_CONTRACTION_ELIGIBILITY",
      "summary": "When the two vowels belong to two separate syllables, otherwise applicable contractions are used.",
      "normative": true,
      "sourceWitnesses": [
        "Sind die beiden Vokale auf zwei Silben verteilt, werden mögliche Kürzungen angewendet"
      ],
      "dependencies": [
        "PRONUNCIATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-LG-020",
      "sourceSection": "4.1.2.5",
      "kind": "INHERITED_VOLLSCHRIFT_VOWEL_RULE",
      "summary": "The inherited Vollschrift rule remains in force: a Vollschrift vowel-group contraction may connect only vowels pronounced within one syllable.",
      "normative": true,
      "sourceWitnesses": [
        "Auch in Kurzschrift bleibt die Vollschriftregel erhalten",
        "nur Vokale verbinden darf"
      ],
      "dependencies": [
        "PRONUNCIATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-LG-021",
      "sourceSection": "4.1.2.6",
      "kind": "SST_DOUBLE_S_PRECEDENCE",
      "summary": "Within SST, the SS contraction has priority.",
      "normative": true,
      "sourceWitnesses": [
        "In \"sst\" das Doppel-s"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-022",
      "sourceSection": "4.1.2.6",
      "kind": "CONSONANT_GROUP_PRECEDENCE",
      "summary": "Within ALL, ELL, EMM, ESCH, ESS and EST, the consonant-group contraction has priority.",
      "normative": true,
      "sourceWitnesses": [
        "In \"all\", \"ell\", \"emm\", \"esch\", \"ess\" und \"est\" die Konsonantengruppe"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-023",
      "sourceSection": "4.1.2.6",
      "kind": "BE_GE_PRECEDENCE",
      "summary": "In the listed BEH/BEL/BEM/BEN/BER/BES and GEH/GEL/GEM/GEN/GER/GES patterns, BE or GE takes precedence when it has prefix or derivational character; the standard also provides established examples such as bereit, geheim and genau.",
      "normative": true,
      "sourceWitnesses": [
        "\"beh\", \"bel\", \"bem\", \"ben\", \"ber\" und \"bes\"",
        "\"geh\"",
        "wenn sie Präfix-/Ableitungscharakter haben",
        "bereit",
        "geheim",
        "genau"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-LG-024",
      "sourceSection": "4.1.2.6",
      "kind": "VOWEL_INITIAL_GROUP_PRECEDENCE",
      "summary": "The vowel-initial groups EH, EL, EM, EN, ER, ES and IG have priority in the source's precedence sequence.",
      "normative": true,
      "sourceWitnesses": [
        "Die mit einem Vokal anlautenden Lautgruppen \"eh\", \"el\", \"em\", \"en\", \"er\", \"es\" und \"ig\""
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-025",
      "sourceSection": "4.1.2.6",
      "kind": "LEFT_TO_RIGHT_FALLBACK",
      "summary": "In all remaining cases, Lautgruppen are contracted in order of occurrence.",
      "normative": true,
      "sourceWitnesses": [
        "In allen übrigen Fällen werden Lautgruppen in der Reihenfolge ihres Vorkommens gekürzt"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-026",
      "sourceSection": "4.1.2.7",
      "kind": "HYPHENATION_MAY_DISSOLVE_CONTRACTION",
      "summary": "At word division, an existing contraction may be dissolved.",
      "normative": true,
      "sourceWitnesses": [
        "Bei Trennungen können Kürzungen ggf. aufgelöst werden"
      ],
      "dependencies": [
        "HYPHENATION_BOUNDARY_INPUT_POLICY"
      ]
    },
    {
      "id": "DE-KURZ-LG-027",
      "sourceSection": "4.1.2.7",
      "kind": "HYPHENATION_NEW_OPPORTUNITY",
      "summary": "If dissolving due to word division creates a new contraction opportunity, that new contraction is applied.",
      "normative": true,
      "sourceWitnesses": [
        "Sollten sich dadurch neue Kürzungsmöglichkeiten ergeben, sind sie anzuwenden"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-028",
      "sourceSection": "4.1.2.7",
      "kind": "HYPHENATION_UNBROKEN_FALLBACK",
      "summary": "Otherwise contraction proceeds as though the word were not divided.",
      "normative": true,
      "sourceWitnesses": [
        "Ansonsten wird so gekürzt, als ob das Wort nicht getrennt wäre"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-LG-029",
      "sourceSection": "4.1.2.8",
      "kind": "POST_APOSTROPHE_PROHIBITION_SET",
      "summary": "Immediately after an apostrophe, AL, AN, AR, BE, EH, EL, EN, LL, MM, OR, SS and TE must not be used as Lautgruppenkürzungen.",
      "normative": true,
      "sourceWitnesses": [
        "dürfen nach Apostroph die Kürzungen für folgende Lautgruppen nicht angewendet werden",
        "\"al\", \"an\", \"ar\", \"be\", \"eh\", \"el\", \"en\", \"ll\", \"mm\", \"or\", \"ss\" und \"te\""
      ],
      "dependencies": []
    }
