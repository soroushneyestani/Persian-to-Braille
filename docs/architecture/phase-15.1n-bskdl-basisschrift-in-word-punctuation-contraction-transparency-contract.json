  "rules": [
    {
      "id": "DE-INWORD-001",
      "section": "2.13",
      "kind": "PROFILE_SCOPE",
      "summary": "The in-word punctuation rules of section 2.13 apply uniformly to Basisschrift, Vollschrift and Kurzschrift.",
      "profiles": [
        "basisschrift",
        "vollschrift",
        "kurzschrift"
      ],
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-INWORD-002",
      "section": "2.13",
      "kind": "COVERED_PUNCTUATION_CLASSES",
      "summary": "Comma, semicolon, colon, question mark, exclamation mark, brackets, quotation marks and arrows are covered when they occur inside words.",
      "classes": [
        "COMMA",
        "SEMICOLON",
        "COLON",
        "QUESTION_MARK",
        "EXCLAMATION_MARK",
        "BRACKETS",
        "QUOTATION_MARKS",
        "ARROWS"
      ],
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-INWORD-003",
      "section": "2.13",
      "kind": "SENTENCE_PERIOD_EXCEPTION",
      "summary": "The sentence period is explicitly excluded from the general in-word cancellation-point rule.",
      "excludedClass": "SENTENCE_PERIOD",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-INWORD-004",
      "section": "2.13",
      "kind": "CANCELLATION_POINT_PREFIX",
      "summary": "A covered punctuation sign or arrow that occurs inside a word receives a preceding cancellation point.",
      "marker": {
        "unicode": "⠠",
        "codepoints": [
          "U+2820"
        ],
        "dots": [
          "6"
        ],
        "cellCount": 1
      },
      "condition": "SIGN_OCCURS_INSIDE_WORD",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-INWORD-005",
      "section": "2.13",
      "kind": "WORD_INTERNAL_POSITION",
      "summary": "The additional cancellation point applies to punctuation that is internal to lexical word material; source examples distinguish such signs from closing punctuation at the word edge.",
      "internalCondition": {
        "lexicalMaterialBefore": true,
        "lexicalMaterialAfter": true
      },
      "evidence": [
        "Hundert(e)",
        "Student(inn)en",
        "Hundert[e]",
