  "rules": [
    {
      "id": "DE-MATH-001",
      "section": "2.10",
      "kind": "INLINE_MATH_ANNOUNCEMENT",
      "summary": "Mathematical signs from the section 2.10 table are normally announced with point 4 when embedded in German text.",
      "marker": {
        "unicode": "⠈",
        "codepoints": [
          "U+2808"
        ],
        "dots": [
          "4"
        ],
        "cellCount": 1
      },
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-MATH-002",
      "section": "2.10",
      "kind": "INLINE_ANNOUNCEMENT_EXCEPTIONS",
      "summary": "The multiplication dot, exponents and rear indices normally omit the point-4 announcement.",
      "exceptions": [
        "MULTIPLICATION_DOT",
        "REAR_UPPER_INDEX",
        "REAR_LOWER_INDEX"
      ],
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-MATH-003",
      "section": "2.10",
      "kind": "INLINE_MATH_SCOPE",
      "summary": "When several mathematical signs occur in one expression, announcement of the first may remain effective through the expression.",
      "terminators": [
        "BRAILLE_BLANK",
        "HYPHEN",
        "SLASH",
        "LETTER_CASE_ANNOUNCEMENT",
        "CANCELLATION_POINT"
      ],
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-MATH-004",
      "section": "2.10",
      "kind": "UNANNOUNCED_LETTER_CASE",
      "summary": "Letters inside the inline mathematical context that are not explicitly case-announced are interpreted as lowercase.",
      "defaultCase": "LOWERCASE",
      "dependency": "15.1G",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-MATH-005",
      "section": "2.10",
      "kind": "MATH_SPACING_IN_TEXT",
      "summary": "Mathematical signs between words have a blank on both sides; a blank between a mathematical sign and a following number or variable is omitted.",
      "spacing": {
        "betweenWords": "BLANK_BOTH_SIDES",
        "beforeNumber": "NO_INTERVENING_BLANK",
        "beforeVariable": "NO_INTERVENING_BLANK"
      },
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-MATH-006",
      "section": "2.10",
      "kind": "MULTIPLICATION_DOT",
      "summary": "A blank before the multiplication dot may be omitted. A number following the multiplication dot must carry a number indicator.",
      "blankBeforeOptional": true,
      "followingNumberRequiresNumberIndicator": true,
      "dependency": "DE-NUM-001",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-MATH-007",
      "section": "2.10",
      "kind": "MULTIPLICATION_ALTERNATIVES",
      "summary": "A print letter x used as multiplication may be retained instead of replacing it with the mathematical multiplication-cross sign. The multiplication star also has an alternate text representation.",
