  "formalRules": [
    {
      "id": "DE-KURZ-STEM-001",
      "sourceSection": "4.2.1",
      "kind": "PREFIX_CONTRACTION_INVENTORY",
      "summary": "ENT and VER are the two contractions defined before word stems.",
      "normative": true,
      "sourceWitnesses": [
        "⠮⠤ ENT-",
        "⠤⠤ VER-"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-STEM-002",
      "sourceSection": "4.2.1",
      "kind": "PREFIX_WORD_INITIAL_ONLY",
      "summary": "ENT and VER contractions are used only at word start before word stems.",
      "normative": true,
      "sourceWitnesses": [
        "nur am Wortanfang vor Wortstämmen verwendet"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-STEM-003",
      "sourceSection": "4.2.1",
      "kind": "PREFIX_SEMANTIC_REQUIREMENT",
      "summary": "ENT and VER must actually function as prefixes to use their §4.2.1 forms.",
      "normative": true,
      "sourceWitnesses": [
        "Sie müssen Präfixe sein"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-STEM-004",
      "sourceSection": "4.2.1",
      "kind": "PREFIX_WORD_INTERIOR_PROHIBITION",
      "summary": "If ENT or VER is pushed into word interior by preceding material, the letters are written out.",
      "normative": true,
      "sourceWitnesses": [
        "ins Wortinnere, müssen sie ausgeschrieben werden"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-STEM-005",
      "sourceSection": "4.2.1",
      "kind": "VER_AFTER_HYPHEN_PROHIBITION",
      "summary": "VER is written out after a hyphen for readability.",
      "normative": true,
      "sourceWitnesses": [
        "Die Kürzung \"ver\" wird nach einem Bindestrich",
        "ausgeschrieben"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-STEM-006",
      "sourceSection": "4.2.2",
      "kind": "POST_STEM_CONTRACTION_INVENTORY",
      "summary": "§4.2.2 defines nine contractions used after word stems.",
      "normative": true,
      "sourceWitnesses": [
        "⠠⠤⠋ -FALLS",
        "⠠⠤⠓ -HEIT",
        "⠠⠤⠅ -KEIT",
        "⠠⠤⠍ -MAL",
        "⠠⠤⠭ -NIS",
        "⠠⠤⠮ -SAM",
        "⠠⠤⠱ -SCHAFT",
        "⠠⠤⠥ -UNG",
        "⠠⠤⠺ -WÄRTS"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-STEM-007",
      "sourceSection": "4.2.2",
      "kind": "POST_STEM_PLACEMENT",
      "summary": "The nine §4.2.2 contractions are used only following word stems.",
      "normative": true,
      "sourceWitnesses": [
        "nur im Anschluss an Wortstämme verwendet"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-STEM-008",
      "sourceSection": "4.2.2",
      "kind": "SUFFIX_REQUIREMENT_EXCEPT_MAL",
      "summary": "Except for MAL, §4.2.2 forms must function as suffixes.",
      "normative": true,
      "sourceWitnesses": [
        "Mit Ausnahme von \"mal\" müssen es Suffixe sein"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-STEM-009",
      "sourceSection": "4.2.2",
      "kind": "SUFFIX_STACKING",
      "summary": "Applicable suffix contractions may follow one another.",
      "normative": true,
      "sourceWitnesses": [
        "Als solche dürfen sie aufeinander folgen"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-STEM-010",
      "sourceSection": "4.2.2",
      "kind": "SUFFIX_ENDING_EXTENSION",
      "summary": "Applicable suffix contractions may take endings.",
      "normative": true,
      "sourceWitnesses": [
        "Endungen annehmen"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-STEM-011",
      "sourceSection": "4.2.2",
      "kind": "COMPOUND_WORD_INTERIOR_POLICY",
      "summary": "Applicable §4.2.2 suffixes may appear inside compounds except MAL and WÄRTS.",
      "normative": true,
      "sourceWitnesses": [
        "mit Ausnahme von \"mal\" und \"wärts\"",
        "bei zusammengesetzten Wörtern auch im Wortinneren stehen"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-STEM-012",
      "sourceSection": "4.2.2",
      "kind": "HEIT_LEXICAL_EXCEPTIONS",
      "summary": "HEIT is not contracted in Hoheit or Rauheit to avoid ambiguity.",
      "normative": true,
      "sourceWitnesses": [
        "\"heit\" darf in \"Hoheit\" nicht gekürzt werden",
        "\"Rauheit\" nicht gekürzt werden"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-STEM-013",
      "sourceSection": "4.2.2",
      "kind": "SCHAFT_LEXICAL_EXCEPTIONS",
      "summary": "SCHAFT is written out in Barschaft and Herrschaft for the source-stated ambiguity/stem reasons.",
      "normative": true,
      "sourceWitnesses": [
        "\"schaft\" ist in \"Barschaft\" auszuschreiben",
        "Auch in \"Herrschaft\" darf \"schaft\" nicht gekürzt werden"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-STEM-014",
      "sourceSection": "4.2.2",
      "kind": "MAL_LEXICAL_EXCEPTION_SET",
      "summary": "MAL is written out in dezimal, formal, maximal, minimal, normal and optimal.",
      "normative": true,
      "sourceWitnesses": [
        "\"mal\" ist in \"dezimal\", \"formal\", \"maximal\", \"minimal\", \"normal\" und \"optimal\" auszuschreiben"
      ],
      "dependencies": []
    },
    {
      "id": "DE-KURZ-STEM-015",
      "sourceSection": "4.2.2",
      "kind": "FALLS_VS_FALL_COMPOUND_DISTINCTION",
      "summary": "The FALLS contraction is not used where Fall is an independent component of a compound, as directly illustrated by Wasserfalls.",
      "normative": true,
      "sourceWitnesses": [
        "\"Fall\" als eigenständiger Wortteil einer Zusammensetzung"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    },
    {
      "id": "DE-KURZ-STEM-016",
      "sourceSection": "4.2.2",
      "kind": "WORD_SEAM_RESTRICTION",
      "summary": "A §4.2.2 contraction must not cross a word seam; Türkeitourismus is the direct source witness.",
      "normative": true,
      "sourceWitnesses": [
        "Türkeitourismus",
        "wegen Wortfugengrenze"
      ],
      "dependencies": [
        "MORPHOLOGICAL_SEGMENTATION_PROVIDER"
      ]
    }
  ],
