      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-007",
      "section": "2.3.1.3",
      "kind": "DATE_AND_TIME",
      "summary": "Dates and times preserve relevant print structure. A hyphen requires a new number indicator; an ambiguous textual colon is announced before the next numeric component.",
      "dependencies": [
        "DE-NUM-012",
        "2.5.1.2"
      ],
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-008",
      "section": "2.3.1.4",
      "kind": "DECIMAL_CLASSIFIER",
      "summary": "Decimal classifiers and chapter/verse references support both print-like notation and a compact alternating lowered/normal numeric notation.",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-009",
      "section": "2.3.1.5",
      "kind": "FRACTION",
      "summary": "For simple natural-number fractions, the numerator uses cardinal digits and the denominator is appended using lowered digits without its own number indicator.",
      "mixedFractionPolicy": "A mixed-number fractional component is attached without a space but begins with its own number indicator.",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-010",
      "section": "2.3.1.6",
      "kind": "PERCENT_PROMILLE_ANGLE",
      "summary": "Percent, promille, degree, minute, and second follow dedicated sign sequences and usually attach to the preceding number without an intervening space.",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-011",
      "section": "2.3.1.7",
      "kind": "SECTION_SIGN",
      "summary": "The section sign is restricted to direct use before Arabic or Roman numbers; repeated print section signs remain repeated and the separating space is omitted.",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-012",
      "section": "2.3.1.8",
      "kind": "AMBIGUOUS_PUNCTUATION",
      "summary": "Punctuation that could be confused with lowered digits requires announcement after an Arabic number or between digits. Text punctuation uses dot 6; mathematical operation usage follows math announcement.",
      "textAnnouncement": {
        "unicode": "⠠",
        "codepoint": "U+2820",
        "dots": "6"
      },
      "mathAnnouncement": {
        "unicode": "⠈",
        "codepoint": "U+2808",
        "dots": "4"
      },
      "normative": true,
      "executable": false,
      "ambiguousTextPunctuation": [
        "SEMICOLON",
        "COLON",
        "QUESTION_MARK",
        "EXCLAMATION_MARK",
        "BRACKET",
        "QUOTATION_MARK"
      ],
      "flowingTextClosingException": {
        "appliesTo": [
          "CLOSING_ROUND_BRACKET",
          "CLOSING_QUOTATION_MARK"
        ],
        "cancellationPointMayUsuallyBeOmitted": true
      }
    },
    {
      "id": "DE-NUM-013",
      "section": "2.3.2",
      "kind": "ROMAN_NUMERAL",
      "summary": "Roman numerals use the corresponding letter cells and must preserve upper/lower-case semantics through the German case-announcement rules.",
      "dependencies": [
        "2.6",
        "2.6.2",
        "2.6.3"
      ],
      "caseStateImplementation": "DEFERRED",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-014",
      "section": "2.4.1",
      "kind": "NUMBER_WORD_BOUNDARY",
      "summary": "A word or word-part may directly follow a number unless its first Braille sign could be interpreted as a cardinal digit or denominator; ambiguous cases require dot 6 or another appropriate announcement.",
      "ambiguityBreaker": {
        "unicode": "⠠",
        "codepoint": "U+2820",
        "dots": "6"
      },
      "normative": true,
      "executable": false,
      "vollKurzContractionPolicy": "Apply contractions where they do not create ambiguity."
    },
    {
      "id": "DE-NUM-015",
      "section": "2.4.2",
      "kind": "NUMBER_UNIT_BOUNDARY",
      "summary": "Spacing between number and unit follows the print source, while half-spaces may be omitted for compact Braille. A line break between the number and its unit is prohibited.",
      "lineBreakAllowed": false,
      "normative": true,
      "executable": false
    }
