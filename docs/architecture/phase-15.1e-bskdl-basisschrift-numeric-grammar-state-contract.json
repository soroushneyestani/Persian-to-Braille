  "rules": [
    {
      "id": "DE-NUM-001",
      "section": "2.3.1.1",
      "kind": "CARDINAL_NUMBER",
      "summary": "Arabic digits use the a-j Braille cells under one leading number indicator.",
      "state": "ARABIC_NUMERIC",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-002",
      "section": "2.3.1.1",
      "kind": "NUMERIC_SCOPE",
      "summary": "The number indicator remains effective through digits and defined decimal/grouping continuation signs; other boundaries terminate numeric scope.",
      "state": "ARABIC_NUMERIC",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-003",
      "section": "2.3.1.1",
      "kind": "DECIMAL_AND_GROUPING",
      "summary": "Decimal comma uses dot 2. Decimal point and digit-grouping point use dot 3.",
      "symbols": {
        "decimalComma": {
          "unicode": "⠂",
          "codepoint": "U+2802",
          "dots": "2"
        },
        "decimalOrGroupingPoint": {
          "unicode": "⠄",
          "codepoint": "U+2804",
          "dots": "3"
        }
      },
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-004",
      "section": "2.3.1.1",
      "kind": "DIGIT_GROUPING",
      "summary": "Print-space grouping is normally represented by a grouping point; long identifier-like digit groups may retain spaces if the number indicator is repeated for each new group.",
      "normative": true,
      "executable": false,
      "printApostropheGrouping": {
        "replacement": {
          "unicode": "⠄",
          "codepoint": "U+2804",
          "dots": "3"
        },
        "requiredWhenUsedAsPrintGrouping": true
      },
      "ungroupedLongNumbersMayBeGroupedForReadability": true,
      "groupingRequiredForOriginallyUngroupedNumbers": false
    },
    {
      "id": "DE-NUM-005",
      "section": "2.3.1.1",
      "kind": "LEADING_NUMERIC_SPECIALS",
      "summary": "A leading apostrophe, leading decimal point, or dash replacing a leading zero follows the number indicator and remains part of the numeric form.",
      "normative": true,
      "executable": false
    },
    {
      "id": "DE-NUM-006",
      "section": "2.3.1.2",
      "kind": "ORDINAL",
      "summary": "Ordinals may be represented with ordinary digits followed by dot 3 or with the compact lowered-digit notation.",
