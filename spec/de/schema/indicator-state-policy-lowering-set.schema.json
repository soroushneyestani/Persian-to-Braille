{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braille-hub.dev/schema/de/indicator-state-policy-lowering-set.schema.json",
  "title": "German Basisschrift Indicator State Policy Lowering Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "phase",
    "id",
    "profile",
    "target",
    "status",
    "source",
    "summary",
    "records",
    "executionBoundary",
    "determinism"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "phase": {
      "const": "15.5B4.3c2"
    },
    "id": {
      "const": "de-basisschrift-indicator-state-policy-lowering"
    },
    "profile": {
      "const": "de-basisschrift"
    },
    "target": {
      "const": "GERMAN_EXECUTION_IR"
    },
    "status": {
      "const": "LOWERED_IR_NON_EXECUTABLE"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudicationPath",
        "adjudicationByteSha256",
        "adjudicationModelCanonicalSha256",
        "executionAdmissionPath",
        "executionAdmissionSha256",
        "priorDirectStructuralIrPath",
        "priorDirectStructuralIrSha256"
      ],
      "properties": {
        "adjudicationPath": {
          "type": "string"
        },
        "adjudicationByteSha256": {
          "$ref": "#/$defs/sha256"
        },
        "adjudicationModelCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "executionAdmissionPath": {
          "type": "string"
        },
        "executionAdmissionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "priorDirectStructuralIrPath": {
          "type": "string"
        },
        "priorDirectStructuralIrSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "loweredRecords",
        "executableRecords",
        "runtimeRegisteredRecords",
        "primaryPrimitiveCounts",
        "auxiliaryFamilyRuleCounts",
        "indicatorFormObjects",
        "dependencyEdges",
        "rulesWithNoAuxiliaryPrimitive"
      ],
      "properties": {
        "records": {
          "const": 62
        },
        "loweredRecords": {
          "const": 62
        },
        "executableRecords": {
          "const": 0
        },
        "runtimeRegisteredRecords": {
          "const": 0
        },
        "primaryPrimitiveCounts": {
          "type": "object"
        },
        "auxiliaryFamilyRuleCounts": {
          "type": "object"
        },
        "indicatorFormObjects": {
          "const": 38
        },
        "dependencyEdges": {
          "const": 12
        },
        "rulesWithNoAuxiliaryPrimitive": {
          "const": 14
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 62,
      "maxItems": 62,
      "items": {
        "$ref": "#/$defs/loweredRecord"
      }
    },
    "executionBoundary": {
      "$ref": "#/$defs/executionBoundary"
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaCanonicalJsonSha256",
        "recordsCanonicalJsonSha256",
        "loweringPayloadCanonicalJsonSha256"
      ],
      "properties": {
        "schemaCanonicalJsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "recordsCanonicalJsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "loweringPayloadCanonicalJsonSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "brailleForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellCount",
        "dots",
        "codepoints",
        "unicode"
      ],
      "properties": {
        "cellCount": {
          "type": "integer",
          "minimum": 1
        },
        "dots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[1-6]+$"
          }
        },
        "codepoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^U\\+[0-9A-F]{4,6}$"
          }
        },
        "unicode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selectedSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "value"
      ],
      "properties": {
        "sourcePath": {
          "type": "string"
        },
        "value": {}
      }
    },
    "indicatorForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "forms"
      ],
      "properties": {
        "kind": {
          "const": "INDICATOR_FORM"
        },
        "forms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourcePath",
              "braille"
            ],
            "properties": {
              "sourcePath": {
                "type": "string"
              },
              "braille": {
                "$ref": "#/$defs/brailleForm"
              }
            }
          }
        }
      }
    },
    "selectedSemanticPrimitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "selectedSemantics"
      ],
      "properties": {
        "kind": {
          "enum": [
            "STATE_TERMINATION",
            "STATE_SCOPE_BOUNDARY",
            "POLICY_BRANCH",
            "PROFILE_OR_MODE_SELECTION"
          ]
        },
        "selectedSemantics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/selectedSemantic"
          }
        }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "targetType",
        "target",
        "resolvedInB43c1"
      ],
      "properties": {
        "sourcePath": {
          "type": "string"
        },
        "targetType": {
          "enum": [
            "RULE_ID",
            "SECTION_REFERENCE"
          ]
        },
        "target": {
          "type": "string"
        },
        "resolvedInB43c1": {
          "const": false
        }
      }
    },
    "dependencyPrimitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "edges"
      ],
      "properties": {
        "kind": {
          "const": "DEPENDENCY_EDGE"
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dependencyEdge"
          }
        }
      }
    },
    "auxiliaryPrimitive": {
      "oneOf": [
        {
          "$ref": "#/$defs/indicatorForm"
        },
        {
          "$ref": "#/$defs/selectedSemanticPrimitive"
        },
        {
          "$ref": "#/$defs/dependencyPrimitive"
        }
      ]
    },
    "loweringState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lowered",
        "executable",
        "runtimeRegistered"
      ],
      "properties": {
        "lowered": {
          "const": true
        },
        "executable": {
          "const": false
        },
        "runtimeRegistered": {
          "const": false
        }
      }
    },
    "loweredRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "sourceLayer",
        "sourceClassification",
        "runtimeOwner",
        "canonicalRulePath",
        "canonicalRuleSha256",
        "canonicalSemanticsSha256",
        "sourceContainerPath",
        "semanticSource",
        "canonicalSemantics",
        "primaryPrimitive",
        "auxiliaryPrimitives",
        "loweringState"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^DE-[A-Z]+-[0-9]{3}$"
        },
        "sourceLayer": {
          "enum": [
            "B2_RUNTIME_CLASSIFICATION",
            "B3_CONTRACT_ROLE"
          ]
        },
        "sourceClassification": {
          "enum": [
            "STATEFUL",
            "INDICATOR",
            "STATE_SCOPE",
            "POLICY_SELECTION"
          ]
        },
        "runtimeOwner": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonicalRulePath": {
          "type": "string"
        },
        "canonicalRuleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalSemanticsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceContainerPath": {
          "type": "string"
        },
        "semanticSource": {
          "enum": [
            "CANONICAL_SEMANTICS",
            "B3_SEMANTIC_PAYLOAD_EXACT"
          ]
        },
        "canonicalSemantics": {
          "type": "object"
        },
        "primaryPrimitive": {
          "enum": [
            "STATE_MACHINE_TRANSITION",
            "INDICATOR_EMISSION",
            "STATE_SCOPE_CONTROL",
            "POLICY_SELECTION"
          ]
        },
        "auxiliaryPrimitives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auxiliaryPrimitive"
          }
        },
        "loweringState": {
          "$ref": "#/$defs/loweringState"
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auxiliaryPrimitivesAdjudicated",
        "loweringMaterialized",
        "stateMachineImplemented",
        "indicatorEmissionImplemented",
        "scopeRuntimeImplemented",
        "policyResolverImplemented",
        "coreModified",
        "translatorModified",
        "executableSpecificationGenerated",
        "germanRuntimeGenerated",
        "germanRuntimeRegistered",
        "persianRuntimeUnchanged"
      ],
      "properties": {
        "auxiliaryPrimitivesAdjudicated": {
          "const": true
        },
        "loweringMaterialized": {
          "const": true
        },
        "stateMachineImplemented": {
          "const": false
        },
        "indicatorEmissionImplemented": {
          "const": false
        },
        "scopeRuntimeImplemented": {
          "const": false
        },
        "policyResolverImplemented": {
          "const": false
        },
        "coreModified": {
          "const": false
        },
        "translatorModified": {
          "const": false
        },
        "executableSpecificationGenerated": {
          "const": false
        },
        "germanRuntimeGenerated": {
          "const": false
        },
        "germanRuntimeRegistered": {
          "const": false
        },
        "persianRuntimeUnchanged": {
          "const": true
        }
      }
    }
  }
}
