{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "German Braille Runtime Rule Classification Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "language",
    "textMode",
    "scope",
    "taxonomy",
    "execution",
    "summary",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "CLASSIFIED_NON_EXECUTABLE"
    },
    "language": {
      "const": "de"
    },
    "textMode": {
      "enum": [
        "basisschrift",
        "vollschrift",
        "kurzschrift"
      ]
    },
    "scope": {
      "type": "object"
    },
    "taxonomy": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "sourceRulePath",
          "sourceRuleSha256",
          "family",
          "kind",
          "section",
          "primaryDisposition",
          "runtimeOwner",
          "decisionRationale",
          "sourceNormative",
          "sourceStatus",
          "executableAtAudit",
          "validationCaseIds",
          "execution"
        ],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "sourceRulePath": {
            "type": "string"
          },
          "sourceRuleSha256": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          },
          "family": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "primaryDisposition": {
            "enum": [
              "DIRECT_MAPPING",
              "CONTEXTUAL",
              "STATEFUL",
              "STRUCTURAL",
              "DELEGATED",
              "DEFERRED",
              "ARCHITECTURAL_ONLY"
            ]
          },
          "runtimeOwner": {
            "type": "string"
          },
          "decisionRationale": {
            "type": "string"
          },
          "sourceNormative": {
            "type": "boolean"
          },
          "sourceStatus": {
            "type": "string"
          },
          "executableAtAudit": {
            "type": "boolean"
          },
          "validationCaseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution": {
            "type": "object"
          }
        }
      }
    }
  }
}
