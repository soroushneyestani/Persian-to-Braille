{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braille-hub.local/schemas/de/historical-fixture-grade-admission.schema.json",
  "title": "German Basisschrift Historical Fixture-Grade Admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "phase",
