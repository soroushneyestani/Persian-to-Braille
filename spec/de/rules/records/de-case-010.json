        "codepoints": [
          "U+2820"
        ],
        "dots": [
          "6"
        ],
        "cellCount": 1
      },
      "capitalThenLowercase": {
        "unicode": "⠨",
        "codepoints": [
          "U+2828"
        ],
        "dots": [
          "46"
        ],
        "cellCount": 1
      }
    }
