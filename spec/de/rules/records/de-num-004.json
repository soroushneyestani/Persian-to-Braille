  },
  "semantics": {
    "summary": "Print-space grouping is normally represented by a grouping point; long identifier-like digit groups may retain spaces if the number indicator is repeated for each new group.",
    "printApostropheGrouping": {
      "replacement": {
        "unicode": "⠄",
        "codepoint": "U+2804",
        "dots": "3"
      },
      "requiredWhenUsedAsPrintGrouping": true
    },
    "ungroupedLongNumbersMayBeGroupedForReadability": true,
    "groupingRequiredForOriginallyUngroupedNumbers": false
  },
