  },
  "semantics": {
    "summary": "In a dot-6-announced lowercase sequence in Kurzschrift, c, q, x, y and sharp-s may need an additional dot 6 when the initial lowercase marker does not unambiguously introduce the sequence.",
    "appliesToProfiles": [
      "kurzschrift"
    ],
    "letters": [
      "c",
      "q",
      "x",
      "y",
      "ß"
    ],
    "additionalDot6MayBeUsed": true,
    "condition": "INITIAL_LOWERCASE_MARKER_NOT_UNAMBIGUOUS_FOR_SEQUENCE"
  },
